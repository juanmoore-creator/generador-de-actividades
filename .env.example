# Copia este archivo como .env.local y completa lo que necesites.
# Sin ninguna variable, GenAct funciona en "modo sin cuenta" (todo se guarda en el navegador).

# --- Cuentas, Mis fichas en la nube y Comunidad (Supabase) ---
# Proyecto → Settings → API. Aplica antes supabase/migrations/*.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Generar palabras con IA (sólo servidor, nunca NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=
